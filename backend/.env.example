# =============================================================
# FinLens AI Backend — Production Environment Variables Template
# =============================================================

# Application Settings
PROJECT_NAME="FinLens AI Backend"
ENVIRONMENT="production"
API_V1_PREFIX="/api"

# Cryptographic Secret Key (Used for secure hashing & signing)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="generate-a-secure-production-secret-key-at-least-32-chars"

# Database Connection (PostgreSQL asyncpg driver)
DATABASE_URL="postgresql+asyncpg://finlens_user:finlens_password@localhost:5432/finlens_db"

# CORS Allowed Origins (Comma-separated list or JSON array)
# In production, restrict to official web domains and Apple scheme
CORS_ORIGINS=["finlens://*", "http://localhost:3000"]
