# =============================================================
# FinLens AI Production Infrastructure Compose Environment Template
# =============================================================

# Port exposed on host for the Nginx gateway
PORT=8088

# PostgreSQL Credentials
POSTGRES_USER=finlens_user
POSTGRES_PASSWORD=finlens_secure_prod_password_change_me
POSTGRES_DB=finlens_db

# Cryptographic Secret Key for Backend
SECRET_KEY=finlens-secure-production-secret-key-32-bytes-minimum

# CORS Configuration for Production
CORS_ORIGINS=["finlens://*", "http://localhost:3000"]
